{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "type": "file-raw",
        "padding": { "top": 1, "left": 2, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "yellow",
            "title": "blue"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "yellow"
        },
        {
            "type": "host",
            "key": " 󰌢 Host",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Uptime",
            "keyColor": "yellow"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "wm",
            "key": " 󰖲 WM",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "  Term",
            "keyColor": "green"
        },
        {
            "type": "editor",
            "key": "  Editor",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": " 󰏖 Pkgs",
            "keyColor": "green"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "cpu",
            "key": " 󰻠 CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": " 󰍛 GPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "  RAM",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk",
            "keyColor": "blue",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
