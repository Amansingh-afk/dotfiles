{
    "layer": "top",
    "position": "bottom",
    "reload_style_on_change": true,
    "modules-left": ["custom/launcher","hyprland/workspaces","hyprland/window","custom/playerctl"],
    "modules-center": [],
    "modules-right": ["custom/appearance","group/expand","tray","bluetooth","network","custom/battery","clock","custom/power"],


    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5 ]
        }
    },
    "hyprland/window": {
        "format": " {title}",
        "icon": true,
        "icon-size": 16,
        "max-length": 25,
        "rewrite": {
            "(.*) - Cursor": "󰨞 $1",
            "(.*) - vim": " $1",
            "(.*) - nvim": "󰺯 $1",
            "(.*) - zsh": " $1",
            "(.*)Spotify": "󰓇 Spotify",
            "(.*)Discord": "󰙯 Discord",
            "(.*)Telegram": "󰔁 Telegram"
        },
        "separate-outputs": true
    },
    "clock": {
        "locale": "en_US.UTF-8",
        "timezone": "Asia/Kolkata",
        "format": "{:%H:%M}",
        "format-alt": "{:%d %B %Y  %H:%M}",
        "tooltip-format": "<span font='JetBrainsMono Nerd Font 11'><tt><small>{calendar}</small></tt></span>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "format": {
                "months":     "<span color='#000000'><b>{}</b></span>",
                "days":       "<span color='#000000'><b>{}</b></span>",
                "weeks":      "<span color='#808080'><b>W{}</b></span>",
                "weekdays":   "<span color='#6e6e6e'><b>{}</b></span>",
                "today":      "<span color='#9999FF'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/playerctl": {
        "format": "{2} <span>{0}</span>",
        "return-type": "json",
        "exec": "playerctl -p spotify metadata -f '{\"text\": \"{{markup_escape(title)}}\", \"tooltip\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "tooltip": false,
        "on-click-middle": "playerctl -p spotify previous",
        "on-click": "playerctl -p spotify play-pause",
        "on-click-right": "playerctl -p spotify next",
        "on-click-forward": "playerctl -p spotify position 10+",
        "on-click-backward": "playerctl -p spotify position 10-",
        "on-scroll-up": "playerctl -p spotify volume 0.02+",
        "on-scroll-down": "playerctl -p spotify volume 0.02-",
        "format-icons": {
            "Paused": " ",
            "Playing": " "
        }
    },
    "network": {
        "format": "{icon}",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": "󰈀",
            "disconnected": "󰤮"
        },
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "SSID: {essid}\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "interval": 5
    },
    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "BT-off",
        "format-disabled": "󰂲",
        "format-connected-battery": "{device_battery_percentage}% 󰂯",
        "format-alt": "{device_alias} 󰂯",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%"
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery-level.sh",
        "format": "{icon}",
        "format-icons": {
            "charging": "󰂄",
            "plugged": "󰚥",
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "tooltip": true,
        "interval": 60,
        "return-type": "json"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "custom/expand": {
        "format": "",
        "tooltip": false
    },
    "custom/endpoint":{
        "format": "|",
        "tooltip": false
    },
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": ["custom/expand","cpu","memory","pulseaudio","custom/appearance","custom/endpoint"]
    },
    "cpu": {
        "format": "󰻠",
        "tooltip": true
    },
    "memory": {
        "format": "󰘚",
        "tooltip": true,
        "tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
        "interval": 5
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "on-click": "pavucontrol",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "tooltip": true,
        "tooltip-format": "{volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰄝",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },
    "custom/appearance": {
        "format": "󰏘",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/appearance-switcher.sh"
    },
    "custom/launcher": {
        "format": "Start",
        "tooltip": true,
        "tooltip-format": "App Launcher",
        "on-click": "~/.config/waybar/scripts/app-launcher.sh"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
