{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "spacing": 4,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window",
    "tray",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "disk",
    "cpu",
    "custom/cpu_temp",
    "backlight",
    "custom/memory",
    "pulseaudio",
    "battery",
    "custom/appearance",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "<span ></span>",
    "on-click": "~/.config/waybar/scripts/app-launcher.sh",
    "on-click-right": "~/.config/waybar/scripts/power-menu.sh",
    "escape": true,
    "tooltip": false
  },
  "hyprland/workspaces": {
    "show-special": true,
    "special-visible-only": true,
    "ignore-workspaces": ["special:.*", "S-.*"],
    "format": "{icon}",
    "format-icons": {
      "1": "<span>󰧨</span>",
      "2": "<span>󰈹</span>",
      "3": "<span></span>",
      "4": "<span></span>",
      "5": "<span></span>",
      "6": "<span>󰭛</span>",
      "7": "<span>󱓷</span>",
      "8": "<span>󰴘</span>",
      "9": "<span>󰟝</span>",
      "10": "<span>󰚀</span>"
    },
    "all-outputs": true,
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "hyprland/window": {
    "format": "<span color='@pink@' > 󰣆 </span>{class} ",
    "icon": false,
    "max-length": 30,
    "separate-outputs": true,
    "tooltip": false
  },
  "hyprland/submap": {
    "format": " {}",
    "max-length": 50,
    "tooltip": false
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "disk": {
    "format": "<span color='@red@'>  </span>{free} ",
    "interval": 20
  },
  "cpu": {
    "format": "<span color='@orange@'>  </span>{usage}% ",
    "tooltip": false,
    "interval": 1,
    "on-click-right": "pypr toggle btop"
  },
  "custom/cpu_temp": {
    "exec": "~/.config/waybar/scripts/ss-cpu-temp.sh",
    "format-icons": {
      "normal": "<span color='@yellow-soft@' > 󰴈 </span>",
      "critical": "<span color='@red-dark@' >  </span>",
      "unknown": "<span color='@gray@' >  </span>"
    },
    "return-type": "json",
    "interval": 2,
    "format": "{icon}{text} ",
    "tooltip": false
  },
  "backlight": {
    "format": "<span color='@yellow@'> 󰞏 </span>{percent}% ",
    "tooltip": false
  },
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/ss-memory.sh",
    "interval": 2,
    "return-type": "json",
    "format": "<span color='@blue-dark@'>  </span>{} ",
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "<span color='@blue@'>  </span>{volume}% ",
    "format-muted": "<span color='@red@'>  </span>{volume}% ",
    "format-bluetooth": "<span color='@blue@'> 󰂰 </span>{volume}% ",
    "format-bluetooth-muted": "<span color='@red@'> 󰂲 </span>{volume}% ",
    "format-source": "{volume}% ",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pypr toggle mixer",
    "tooltip": false,
    "max-volume": 130
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format": "<span color='@green-dark@' > {icon} </span>{capacity}% ",
    "format-critical": "<span color='@red-dark@' > {icon} </span>{capacity}%!! ",
    "format-warning": "<span color='@orange@' > {icon} </span>{capacity}% ",
    "format-full": "<span color='@green-dark@' > {icon} </span>{capacity}% ",
    "format-charging": "<span color='@green-dark@' > 󰂅 </span>{capacity}% ",
    "format-charging-warning": "<span color='@orange@' > 󰢝 </span>{capacity}% ",
    "format-charging-critical": "<span color='@red-dark@' > 󰢜 </span>{capacity}% ",
    "format-plugged": "<span color='@green-dark@' > 󰂅 </span>{capacity}% ",
    "format-alt": "<span color='@green-dark@' > 󱧥 </span>{time} ",
    "tooltip": false
  },
  "network": {
    "interval": 2,
    "format": "<span color='@pink@'> 󱘖 </span>{bandwidthDownBits} ",
    "format-wifi": "<span color='@pink@'> {icon} </span>{bandwidthDownBits} ",
    "format-ethernet": "<span color='@pink@'> 󰈀 </span>{bandwidthDownBits} ",
    "format-icons": [
      "󰤫",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": false,
    "states": {
      "normal": 25
    },
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },
  "clock": {
    "format": "<span color='@green@' >  </span>{:%a %d | %H:%M} ",
    "tooltip": false,
    "interval": 1
  },
  "custom/appearance": {
    "format": "󰏘",
    "tooltip": true,
    "tooltip-format": "Appearance",
    "on-click": "~/.config/waybar/scripts/appearance-switcher.sh"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": true,
    "tooltip-format": "Power",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
