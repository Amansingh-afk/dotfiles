/**
 * Power Menu - Sleek & Compact
 */

configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font 11";
    hover-select:               true;
}

@import "themes/current.rasi"

window {
    width:                      160px;
    border:                     1px;
    border-radius:              12px;
    border-color:               @grey0;
    background-color:           @bg0;
    location:                   northeast;
    anchor:                     northeast;
    x-offset:                   -10px;
    y-offset:                   10px;
}

mainbox {
    background-color:           transparent;
    children:                   [ listview ];
}

listview {
    columns:                    1;
    lines:                      5;
    spacing:                    4px;
    padding:                    8px;
    cycle:                      true;
    dynamic:                    false;
    scrollbar:                  false;
    background-color:           transparent;
}

element {
    padding:                    8px 12px;
    cursor:                     pointer;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @fg0;
}

element-text {
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
    horizontal-align:           0.0;
    vertical-align:             0.5;
}

element selected.normal {
    background-color:           @grey0;
    text-color:                 @fg0;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg0;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg0;
}

@import "theme-overrides.rasi"
