/**
 * WiFi Menu - Sleek & Compact
 */

configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font 11";
    hover-select:               true;
}

@import "themes/current.rasi"

window {
    width:                      280px;
    border:                     1px;
    border-radius:              12px;
    border-color:               @grey0;
    background-color:           @bg0;
    location:                   northeast;
    anchor:                     northeast;
    x-offset:                   -10px;
    y-offset:                   10px;
}

mainbox {
    background-color:           transparent;
    children:                   [ inputbar, listview ];
}

inputbar {
    padding:                    10px 12px;
    spacing:                    8px;
    background-color:           @bg1;
    border-radius:              11px 11px 0 0;
    children:                   [ prompt, entry ];
}

prompt {
    background-color:           transparent;
    text-color:                 @blue;
}

entry {
    placeholder:                "Search...";
    placeholder-color:          @grey1;
    background-color:           transparent;
    text-color:                 @fg0;
    cursor:                     text;
}

listview {
    columns:                    1;
    lines:                      8;
    spacing:                    4px;
    padding:                    8px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    background-color:           transparent;
}

element {
    padding:                    8px 12px;
    cursor:                     pointer;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @fg0;
}

element-text {
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
    horizontal-align:           0.0;
    vertical-align:             0.5;
}

element selected.normal {
    background-color:           @grey0;
    text-color:                 @fg0;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg0;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg0;
}

/* Connected network highlight */
element normal.active {
    background-color:           transparent;
    text-color:                 @green;
}

element alternate.active {
    background-color:           transparent;
    text-color:                 @green;
}

element selected.active {
    background-color:           @grey0;
    text-color:                 @green;
}

textbox-custom {
    expand:                     false;
    content:                    "WiFi is disabled";
    background-color:           transparent;
    text-color:                 @grey1;
    padding:                    12px;
    horizontal-align:           0.5;
}
