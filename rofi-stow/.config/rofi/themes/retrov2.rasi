/**
 * Retrov2 Theme for Rofi — ClassicPlatinumStreamlined / Mac OS 9 aesthetic
 */

* {
    bg0:                #DCDCDC;
    bg1:                #c0c0c0;
    bg2:                #d0d0d0;
    grey0:              #b0b0b0;
    grey1:              #9b9b9b;
    grey2:              #808080;
    fg0:                #000000;
    fg1:                #1a1a1a;
    fg2:                #6e6e6e;
    red:                #CC0000;
    orange:             #FF8000;
    yellow:             #808000;
    green:              #008000;
    aqua:               #008080;
    blue:               #9999FF;
    purple:             #800080;
    bgStatusline3:      #b0b0b0;
    background-color:   transparent;
    text-color:         @fg0;
}

window {
    width:              600px;
    border:             1px;
    border-radius:      16px;
    border-color:       @grey1;
    background-color:   @bg0;
}

mainbox {
    spacing:            0;
    background-color:   transparent;
    children:           [inputbar, message, listview];
}

inputbar {
    padding:            16px 20px;
    spacing:            12px;
    background-color:   @bg1;
    border-radius:      14px 14px 0 0;
    children:           [prompt, entry];
}

prompt {
    padding:            0px 8px 0px 0px;
    background-color:   transparent;
    text-color:         @fg0;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @grey2;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             text;
}

message {
    padding:            12px;
    background-color:   @bg2;
}

textbox {
    background-color:   transparent;
    text-color:         @fg1;
}

listview {
    lines:              8;
    columns:            1;
    padding:            8px;
    spacing:            4px;
    scrollbar:          false;
    background-color:   @bg0;
    border-radius:      0 0 14px 14px;
}

element {
    padding:            10px 16px;
    spacing:            12px;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             pointer;
}

element normal.normal {
    background-color:   transparent;
}

element alternate.normal {
    background-color:   transparent;
}

element selected.normal {
    background-color:   @blue;
    text-color:         #FFFFFF;
}

element-icon {
    size:               24px;
    background-color:   transparent;
    text-color:         inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

error-message {
    padding:            20px;
    background-color:   @bg1;
    border:             1px;
    border-color:       @grey1;
    border-radius:      12px;
}
