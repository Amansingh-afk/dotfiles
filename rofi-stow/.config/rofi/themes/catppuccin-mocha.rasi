/**
 * Catppuccin Mocha Theme for Rofi
 */

* {
    bg0:                #1e1e2e;
    bg1:                #181825;
    bg2:                #313244;
    grey0:              #45475a;
    grey1:              #585b70;
    grey2:              #6c7086;
    fg0:                #cdd6f4;
    fg1:                #bac2de;
    fg2:                #a6adc8;
    red:                #f38ba8;
    orange:             #fab387;
    yellow:             #f9e2af;
    green:              #a6e3a1;
    aqua:               #94e2d5;
    blue:               #89b4fa;
    purple:             #cba6f7;
    bgStatusline3:      #45475a;
    background-color:   transparent;
    text-color:         @fg0;
}

window {
    width:              600px;
    border:             2px;
    border-radius:      16px;
    border-color:       @grey0;
    background-color:   @bg0;
}

mainbox {
    spacing:            0;
    background-color:   transparent;
    children:           [inputbar, message, listview];
}

inputbar {
    padding:            16px 20px;
    spacing:            12px;
    background-color:   @bg1;
    border-radius:      14px 14px 0 0;
    children:           [prompt, entry];
}

prompt {
    padding:            0px 8px 0px 0px;
    background-color:   transparent;
    text-color:         @blue;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @grey2;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             text;
}

message {
    padding:            12px;
    background-color:   @bg2;
}

textbox {
    background-color:   transparent;
    text-color:         @fg1;
}

listview {
    lines:              8;
    columns:            1;
    padding:            8px;
    spacing:            4px;
    scrollbar:          false;
    background-color:   @bg0;
    border-radius:      0 0 14px 14px;
}

element {
    padding:            10px 16px;
    spacing:            12px;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             pointer;
}

element normal.normal {
    background-color:   transparent;
}

element alternate.normal {
    background-color:   transparent;
}

element selected.normal {
    background-color:   @grey0;
    text-color:         @fg0;
}

element-icon {
    size:               24px;
    background-color:   transparent;
    text-color:         inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

error-message {
    padding:            20px;
    background-color:   @bg1;
    border:             2px;
    border-color:       @red;
    border-radius:      12px;
}
