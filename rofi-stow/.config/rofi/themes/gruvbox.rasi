/**
 * Gruvbox Theme for Rofi
 */

* {
    bg0:                #1d2021;
    bg1:                #282828;
    bg2:                #32302f;
    grey0:              #504945;
    grey1:              #665c54;
    grey2:              #7c6f64;
    fg0:                #fbf1c7;
    fg1:                #ebdbb2;
    fg2:                #d5c4a1;
    red:                #fb4934;
    orange:             #fe8019;
    yellow:             #fabd2f;
    green:              #b8bb26;
    aqua:               #8ec07c;
    blue:               #83a598;
    purple:             #d3869b;
    bgStatusline3:      #504945;
    background-color:   transparent;
    text-color:         @fg0;
}

window {
    width:              600px;
    border:             2px;
    border-radius:      16px;
    border-color:       @grey0;
    background-color:   @bg0;
}

mainbox {
    spacing:            0;
    background-color:   transparent;
    children:           [inputbar, message, listview];
}

inputbar {
    padding:            16px 20px;
    spacing:            12px;
    background-color:   @bg1;
    border-radius:      14px 14px 0 0;
    children:           [prompt, entry];
}

prompt {
    padding:            0px 8px 0px 0px;
    background-color:   transparent;
    text-color:         @orange;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @grey1;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             text;
}

message {
    padding:            12px;
    background-color:   @bg2;
}

textbox {
    background-color:   transparent;
    text-color:         @fg1;
}

listview {
    lines:              8;
    columns:            1;
    padding:            8px;
    spacing:            4px;
    scrollbar:          false;
    background-color:   @bg0;
    border-radius:      0 0 14px 14px;
}

element {
    padding:            10px 16px;
    spacing:            12px;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             pointer;
}

element normal.normal {
    background-color:   transparent;
}

element alternate.normal {
    background-color:   transparent;
}

element selected.normal {
    background-color:   @grey0;
    text-color:         @fg0;
}

element-icon {
    size:               24px;
    background-color:   transparent;
    text-color:         inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

error-message {
    padding:            20px;
    background-color:   @bg1;
    border:             2px;
    border-color:       @red;
    border-radius:      12px;
}
