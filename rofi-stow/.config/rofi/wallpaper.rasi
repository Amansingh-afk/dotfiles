/**
 * Wallpaper picker — card grid
 */

@import "themes/current.rasi"

configuration {
    show-icons:         true;
    hover-select:       true;
}

window {
    width:              1180px;
    location:           center;
    anchor:             center;
    x-offset:           0;
    y-offset:           0;
}

mainbox {
    spacing:            0;
    background-color:   transparent;
    children:           [ inputbar, message, listview ];
}

inputbar {
    padding:            14px 20px;
    spacing:            12px;
    children:           [ prompt, entry ];
}

entry {
    placeholder:        "Filter…";
}

message {
    padding:            8px 20px;
    background-color:   @bg1;
}

textbox {
    background-color:   transparent;
    text-color:         @fg1;
}

listview {
    columns:            4;
    lines:              3;
    flow:               horizontal;
    fixed-columns:      true;
    spacing:            14px;
    padding:            16px;
    scrollbar:          false;
    cycle:              true;
    dynamic:            true;
    background-color:   transparent;
}

element {
    orientation:        vertical;
    padding:            10px 10px 12px 10px;
    spacing:            10px;
    border:             2px;
    border-color:       transparent;
    background-color:   @bg1;
    text-color:         @fg0;
    cursor:             pointer;
}

element normal.normal, element alternate.normal {
    background-color:   @bg1;
    border-color:       transparent;
}

element selected.normal {
    background-color:   @grey0;
    border-color:       @orange;
    text-color:         @fg0;
}

/* "current" items */
element normal.active, element alternate.active {
    background-color:   @bg1;
    border-color:       @green;
    text-color:         @green;
}

element selected.active {
    background-color:   @grey0;
    border-color:       @green;
    text-color:         @green;
}

button {
    padding:            10px 0;
    background-color:   @bg1;
    text-color:         @fg1;
    cursor:             pointer;
}

button selected {
    background-color:   @orange;
    text-color:         @bg0;
}

element-icon {
    size:               215px;
    horizontal-align:   0.5;
    background-color:   transparent;
    cursor:             inherit;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
}
